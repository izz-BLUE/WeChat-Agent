WECHATY_PUPPET=xp
BOT_MODE=smoke
BOT_DISPLAY_NAME=椰椰

OPENAI_API_BASE=
OPENAI_API_KEY=
OPENAI_MODEL=

CONTEXT_MESSAGE_LIMIT=50
MAX_CONTEXT_MESSAGES=100
MAX_CONTEXT_CHARS=12000

# Process-local group context budgets. These are not persistent memory.
GROUP_AMBIENT_MAX_ENTRIES=30
GROUP_AMBIENT_TTL_MINUTES=30
GROUP_AMBIENT_MAX_CHARS=4000
GROUP_REQUESTER_LOCAL_MAX_ENTRIES=50
GROUP_REQUESTER_LOCAL_TTL_MINUTES=30
GROUP_REQUESTER_LOCAL_MAX_CHARS=8000

# Process-local topic capsules, compacted only after a real group SENT ACK.
GROUP_TOPIC_CAPSULE_ENABLED=1
GROUP_TOPIC_CAPSULE_TRIGGER_EVENT_COUNT=8
GROUP_TOPIC_CAPSULE_TRIGGER_CHAR_COUNT=1200
GROUP_TOPIC_CAPSULE_MAX_PER_GROUP=8
GROUP_TOPIC_CAPSULE_TTL_HOURS=24
GROUP_TOPIC_CAPSULE_MAX_SELECTED=3
GROUP_TOPIC_CAPSULE_SUMMARY_MAX_CHARS=800
GROUP_TOPIC_CAPSULE_MAX_CHARS=2400
GROUP_TOPIC_CAPSULE_RECENT_RAW_ENTRIES=8
GROUP_TOPIC_CAPSULE_RECENT_RAW_CHARS=2000
GROUP_TOPIC_CAPSULE_COMPACTION_TIMEOUT_MS=3000

# Identity observation probe: observation only, 1 enables [IDENTITY_OBSERVE] token logging
WECHAT_IDENTITY_OBSERVE=0

# Persistent runtime log. Default path: %LOCALAPPDATA%\WeChatAgent\logs\agent-*.log.
# WECHAT_LOG_PATH overrides the directory. A logging failure never breaks chat.
WECHAT_LOG_PATH=

# Cross-process token correlation with the C# UI (IdentityTokens.Token).
# Set the SAME value on the UI process and on this Agent process to make a
# token match across hook-ui-*.log and agent-*.log. Leave it empty and each
# process keeps its own random salt: the privacy contract still holds, but the
# logs then report TOKEN_CORRELATION mode=PROCESS_LOCAL and the tokens MUST NOT
# be read as cross-process correlated. Never commit a real value; the salt is
# never written to the log.
WECHAT_LOG_TOKEN_SALT=

# Persistent memory (GROUP only). Runtime data must never live in a candidate /
# freeze artifact root; the default is %LOCALAPPDATA%\WeChatAgent\memory.
#
# Retrieval is deterministic: the store authorizes, the budget bounds, and the
# final chat turn is the only model call an active request makes. There is no
# semantic-selector switch: relevance is judged by the final model, which sees
# the ambient transcript, the recent conversation and the authorized memories
# together.
WECHAT_MEMORY_ENABLED=1
WECHAT_MEMORY_PATH=

# Autonomous web search. Disabled by default. Degoog is the default local
# multi-engine aggregator and requires a running Degoog service. SearXNG is an
# optional compatibility/fallback route. Credentials and raw provider payloads
# never enter logs or prompts.
WEB_SEARCH_ENABLED=0
SEARCH_PROVIDER=degoog
DEGOOG_API_BASE=http://127.0.0.1:4444
# WEB_SEARCH_PROVIDER=tavily is a legacy alias used only when SEARCH_PROVIDER is unset.
TAVILY_API_BASE=
TAVILY_API_KEY=
SEARXNG_ENABLED=0
SEARXNG_API_BASE=http://127.0.0.1:8088
SEARXNG_ENGINES=360search,sogou
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT_MS=8000
WEB_SEARCH_MAX_CONTEXT_CHARS=6000
WEB_PAGE_FETCH_ENABLED=1
WEB_PAGE_FETCH_MAX_RESULTS=2
WEB_PAGE_FETCH_TIMEOUT_MS=4000
WEB_PAGE_FETCH_MAX_CHARS_PER_PAGE=4000
WEB_PAGE_FETCH_MAX_TOTAL_CHARS=6000
MEMORY_BACKGROUND_TIMEOUT_MS=8000
AGENT_REQUEST_DEADLINE_MS=50000

# Runtime time grounding. Empty uses the host system timezone.
AGENT_TIME_ZONE=
